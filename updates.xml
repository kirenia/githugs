---
permalink: /updates.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  the announcement feed, the one the bridges read. feed.xml is still the blog.
  newest first, drafts and past ones skipped, 25 at most. the filename is the guid, so
  renaming a file posts it again and editing the title does not.
{%- endcomment -%}
{%- assign items = site.updates | sort: "date" | reverse -%}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.title | escape }} updates</title>
    <link>{{ '/updates/' | absolute_url }}</link>
    <atom:link href="{{ '/updates.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <description>Book club nights and announcements.</description>
    <language>en-us</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- for u in items limit: 25 -%}
    {%- comment -%} past ones stay on the page but never go back out the feed {%- endcomment -%}
    {%- unless u.draft or u.past -%}
    {%- assign slug = u.path | split: "/" | last | split: "." | first -%}
    {%- if u.link -%}
      {%- assign target = u.link -%}
    {%- else -%}
      {%- capture target -%}{{ '/updates/' | absolute_url }}#{{ slug }}{%- endcapture -%}
    {%- endif %}
    <item>
      <title>{{ u.title | escape }}</title>
      <link>{{ target }}</link>
      <guid isPermaLink="false">githugs-update-{{ slug }}</guid>
      <pubDate>{{ u.date | date_to_rfc822 }}</pubDate>
      <description>{{ u.content | markdownify | strip_html | normalize_whitespace | strip | escape }}</description>
      {%- if u.image %}
      {%- assign img = u.image | absolute_url %}
      <enclosure url="{{ img }}" type="image/{% if u.image contains '.png' %}png{% else %}jpeg{% endif %}" length="0" />
      <media:content url="{{ img }}" medium="image">
        {%- if u.image_alt %}<media:description>{{ u.image_alt | escape }}</media:description>{% endif -%}
      </media:content>
      {%- endif %}
    </item>
    {%- endunless -%}
    {%- endfor %}
  </channel>
</rss>
